<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.dao.ChatMessageMapper">

    <resultMap id="BaseMap" type="ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="source" property="source"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_message (session_id, role, content, source)
        VALUES (#{sessionId}, #{role}, #{content}, #{source})
    </insert>

    <select id="findRecent" resultMap="BaseMap">
        SELECT * FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY id DESC
        LIMIT #{limit}
    </select>
</mapper>
